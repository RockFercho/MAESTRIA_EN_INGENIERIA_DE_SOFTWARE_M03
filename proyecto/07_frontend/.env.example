# URL base de la API del backend (RF-027 / CP-API-01)
# - En desarrollo se recomienda el valor relativo /api/v1: Vite redirige la
#   petición mediante proxy hacia VITE_API_PROXY_TARGET (evita CORS).
# - En producción se puede indicar la URL absoluta del backend,
#   p. ej. http://127.0.0.1:3001/api/v1 (requiere CORS habilitado en el backend).
VITE_API_BASE_URL=/api/v1

# Destino del proxy de desarrollo de Vite (backend Express).
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
