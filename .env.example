# Paso 16 — Conexión: plantilla de variables de entorno
# Copiar a `.env` (raíz del repositorio) y rellenar en el entorno.
# `.env` está en .gitignore (.env, .env.*): NUNCA se versiona ni se commitea (RNF-004).
# Este archivo NO contiene credenciales reales — sólo marcadores vacíos.
# Leer credenciales SÓLO desde .env (workflow Paso 16).

# Conexión del servidor MySQL 8.0.46 (D-06-R1)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestion_citas_db

# Cuenta con privilegios de DDL para aplicar 13_sql/ (seguridad.md §2: migrador)
DB_MIGRADOR_USER=migrador
DB_MIGRADOR_PASSWORD=

# Contraseñas de las cuentas creadas fuera del repositorio (plantilla de 0005)
DB_PASSWORD_APP_RW=
DB_PASSWORD_APP_APPEND=
DB_PASSWORD_APP_OUTBOX=
DB_PASSWORD_BACKUP_RO=
